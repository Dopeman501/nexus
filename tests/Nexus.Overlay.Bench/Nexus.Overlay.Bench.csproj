<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverlaySource Condition="'$(OverlaySource)' == ''">$(MSBuildThisFileDirectory)..\..\src</OverlaySource>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(OverlaySource)/**/*.cs" Exclude="$(OverlaySource)/Logger.cs;$(OverlaySource)/Program.cs" LinkBase="Product" />
  </ItemGroup>
</Project>
